@startuml
' UC12: Hóeltakarítás sószóró fejjel
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "tesztelő" as T
participant "snowplow : SnowPlow" as P
participant "saltVommiter : SaltVommiter" as SV
participant "cleaner : Cleaner" as C
participant "outdoorLane : OutdoorLane" as L
participant "dryState : DryState" as D

T -> P : refillAttachment()
activate P
    P -> C : getScore()
    activate C
    C -->> P : 100
    deactivate C
    P -> SV : refill(100)
    activate SV
        note right: 100 >= priceOfFuel(1)\nfuelLevel = FULL_TANK (20)
        SV -->> P : 99
    deactivate SV
    P -> C : setScore(99)
    activate C
    deactivate C
    P -->> T :
deactivate P

T -> P : interactWithLane(outdoorLane, 0)
activate P
    P -> SV : cleanLane(outdoorLane, 0)
    activate SV
        note right: fuelLevel > 0
        SV -> L : cleanWithSaltVomitter(0)
        activate L
            L -> D : cleanWithSaltVomitter(0)
            activate D
                create participant "salted : SaltedState" as ST
                D -> ST : <<create>>
                D -->> L : salted
            deactivate D
            L -> L : setState(salted)
            note right: saltedTimestamp = 0\nsnowAmount = 0
            L -->> SV :
        deactivate L
        note right: fuelLevel--
        SV -->> P : true
    deactivate SV
    P -> C : addIncome(2)
    activate C
    deactivate C
    P -->> T :
deactivate P
@enduml
