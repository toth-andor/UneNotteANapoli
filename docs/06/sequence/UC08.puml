@startuml
' UC8: Hókotró fej újratöltése
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "tesztelő" as T
participant "snowplow : SnowPlow" as P
participant "cleaner : Cleaner" as C
participant "dragon : Dragon" as DR

T -> P : buyAttachment(dragon)
activate P
    P -> DR : getPrice()
    activate DR
    DR -->> P : 10
    deactivate DR
    P -> C : getScore()
    activate C
    C -->> P : 15
    deactivate C
    note right: 10 <= 15 → vásárlás lehetséges\nownedTools.add(dragon)
    P -> C : getScore()
    activate C
    C -->> P : 15
    deactivate C
    P -> DR : getPrice()
    activate DR
    DR -->> P : 10
    deactivate DR
    P -> C : setScore(5)
    activate C
    deactivate C
    P -->> T : true
deactivate P

T -> P : changeAttachment(dragon)
activate P
    note right: ownedTools.contains(dragon) → igaz\ncurrentTool = dragon
    P -->> T : true
deactivate P

T -> P : refillAttachment()
activate P
    P -> C : getScore()
    activate C
    C -->> P : 5
    deactivate C
    P -> DR : refill(5)
    activate DR
        note right: 5 >= priceOfFuel(2)\nfuelLevel = FULL_TANK (20)
        DR -->> P : 3
    deactivate DR
    P -> C : setScore(3)
    activate C
    deactivate C
    P -->> T :
deactivate P
@enduml
