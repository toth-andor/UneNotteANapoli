@startuml
' UC3: Takarítás és ennek hatására egyenleg változása
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "tesztelő" as T
participant "snowplow : SnowPlow" as P
participant "DefaultAttachment : VomitingHead" as V
participant "lane : OutdoorLane" as L
participant "snowy : SnowyState" as ST
participant "cleaner : Cleaner" as C

T -> P : interactWithLane(lane, 0)
activate P
    P -> V : cleanLane(lane, 0)
    activate V
        V -> L : cleanWithVomittingHead()
        activate L
            L -> ST : cleanWithVomittingHead()
            activate ST
                create participant "dry : DryState" as D
                ST -> D : <<create>>
                ST -->> L : dry
            deactivate ST
            L -> L : setState(dry)
            note right: snowAmount = 0
            L -->> V :
        deactivate L
        V -->> P : true
    deactivate V
    P -> C : addIncome(2)
    activate C
    deactivate C
    P -->> T :
deactivate P

T -> C : getScore()
activate C
C -->> T : balance
deactivate C
@enduml
