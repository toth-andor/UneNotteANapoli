@startuml
' UC14: Söprőfej hatása szomszédos sávok esetén
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "tesztelő" as T
participant "snowplow : SnowPlow" as P
participant "sweeper : Sweeper" as SW
participant "snowyLane : OutdoorLane" as L1
participant "snowy : SnowyState" as ST1
participant "dryLane : OutdoorLane" as L2
participant "dry : DryState" as ST2
participant "cleaner : Cleaner" as C

T -> P : interactWithLane(snowyLane, 0)
activate P
    P -> SW : cleanLane(snowyLane, 0)
    activate SW
        SW -> L1 : cleanWithSweeper()
        activate L1
            L1 -> ST1 : cleanWithSweeper()
            activate ST1
                create participant "newDry : DryState" as ND
                ST1 -> ND : <<create>>
                ST1 -->> L1 : newDry
            deactivate ST1
            L1 -> L1 : setState(newDry)
            note right: snowAmount = 0\ntarget = dryLane (kisebb indexű szomszéd sáv)
            L1 -> L2 : snowFall(snowToPush)
            activate L2
                note right: snowAmount += snowToPush
                L2 -> ST2 : handleSnow(dryLane, snowToPush)
                activate ST2
                    note right: snowAmount >= küszöb(5)
                    create participant "snowy2 : SnowyState" as ST3
                    ST2 -> ST3 : <<create>>
                    ST2 -->> L2 : snowy2
                deactivate ST2
                L2 -> L2 : setState(snowy2)
                L2 -->> L1 :
            deactivate L2
            L1 -->> SW :
        deactivate L1
        SW -->> P : true
    deactivate SW
    P -> C : addIncome(2)
    activate C
    deactivate C
    P -->> T :
deactivate P
@enduml
