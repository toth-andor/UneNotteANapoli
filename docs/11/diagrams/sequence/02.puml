@startuml
' SD-UI-02: Felhasználói interakció – sáv kiválasztása
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Felhasználó" as User
participant "gw : GameWindow\n(MouseListener)" as GW
participant "ctrl : Controller" as Ctrl
participant "v : vehicle" as V
participant "vv : VehicleView" as VV
participant "jv : JunctionView" as JV
participant "lv : LaneView" as LV
participant "cv : CleanerView" as CV
participant "gp : GamePanel" as GP

User -> GW : mouseClicked(event)
activate GW
    GW -> GW : msg = new PickLane(l)
    GW -> GW : dispatchMessage(msg)
    GW -> Ctrl : receive(msg)
    activate Ctrl
        Ctrl -> V : gotoLane(lane, timestamp)
        activate V
            V -> V : notifyObservers()
            V -> VV : update()
            activate VV
                VV -> V : getCurrentLane()
                VV -> VV : x, y koordináták frissítése\na sáv pozíciója alapján
                VV -> GP : repaint()
            deactivate VV
        deactivate V
    deactivate Ctrl
deactivate GW

GP -> GP : paintComponent(g)
activate GP
    GP -> JV : draw(g)
    activate JV
        JV -> JV : g.fillRect(x, y, width, height)
    deactivate JV
    GP -> LV : draw(g)
    activate LV
        LV -> LV : g.fillRect(x, y, width, height)
    deactivate LV
    GP -> VV : draw(g)
    activate VV
        VV -> VV : g.fillRect(x, y, width, height)
    deactivate VV
    GP -> CV : draw(g)
    activate CV
        CV -> CV : g.fillRect(x, y, width, height)
    deactivate CV
deactivate GP
@enduml
