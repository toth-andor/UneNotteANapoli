@startuml
actor "Rendszer / Játékos" as A
participant "v: Vehicle" as V
participant "currentLane: Lane" as L1
participant "targetLane: Lane" as L2

A -> V : nextTurn()
activate V
    V -> V : checkMobility()
    note right: Ellenőrzi, hogy letelt-e a várakozási idő 
    
    alt isImmobilized == false
        V -> L1 : getNextLane()
        activate L1
        L1 --> V : targetLane
        deactivate L1
        
        V -> L2 : acceptVehicle(v)
        activate L2
            L2 --> V : success / failure
        deactivate L2
        
        alt Sikeres belépés
            V -> V : updatePosition()
            V -> V : interactWithRoad()
        end
    end
deactivate V
@enduml